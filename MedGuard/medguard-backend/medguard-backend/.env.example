# Copy this file to ".env" and fill in your own PostgreSQL username/password.
#
# Format:
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>
#
# Example if your PostgreSQL user is "postgres" with password "postgres",
# running on your own computer, database named "medguard":
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medguard
